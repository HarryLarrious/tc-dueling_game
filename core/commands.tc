// Player interaction: chat commands, boarding, getting out.

/** One-time setup the first time any code runs on the plot. */
function ensureInitialized {
    if (global initialized != 12) {
        // 12: every part has a hitbox, HP and loss state (combat/); older
        // mechs have none. Hull displays of plots from before 8 (mBody) are removed.
        for (line body of global mBody as list) {
            select entitiesByName(line body as str);
            selectedEntity.remove();
            select reset;
        }
        global mBody = [];
        clearMechs();
        resetConfig();
        global floorSet = 0;
        global initialized = 12;
    }
    ensureCatalog();
}

/** Default tunables. */
function resetConfig {
    global mechHover = 0.3;
    global mechPower = 2.5;
    global turnEase = 0.7;
    global idleEase = 0.3;
    global arenaR = 25;
}

/** Removes every mech entity and empties the mech lists. Pilots lose their
 * cockpit, schema and visor first (MEC-104). */
function clearMechs {
    repeat (line c to global mCount) {
        line pilot = global mDriver[line c];
        if (line pilot != "") {
            schemaHide(line pilot);
            cockpitHide(line pilot);
            fxCockpit(line pilot, 0);
        }
        select entitiesByName(global mSeat[line c]);
        selectedEntity.remove();
        select reset;
    }
    for (line part of global mPartEnt) {
        select entitiesByName(line part as str);
        selectedEntity.remove();
        select reset;
    }
    global augState = {};
    global hrbAt = {};
    global mRad = [];
    global mPos = [];
    global mYaw = [];
    global mF = [];
    global mSeat = [];
    global mDriver = [];
    global mPartEnt = [];
    global mPartStart = [];
    global mPartCount = [];
    global mDrawnPos = [];
    global mDrawnYaw = [];
    global mSeatUp = [];
    global hbAt = [];
    global hbX = [];
    global hbY = [];
    global hbZ = [];
    global hbKind = [];
    global mPartRole = [];
    global mBoundUp = [];
    global mBound = [];
    global mBoundAt = [];
    global hbHp = [];
    global hbHpMax = [];
    global mImpulse = [];
    global mLoss = [];
    global mLastHit = [];
    clearDebris();
    global mLoadout = [];
    global mClass = [];
    global mStats = [];
    global mSize = [];
    global mAlive = [];
    global mCount = 0;
}

/** Index of the mech `uuid` pilots, or 0. */
function mechOf(uuid: str): num {
    return global mDriver.find(uuid);
}

/** The mech the player pilots, or the nearest alive one within 8 blocks, or 0. */
function nearestMech(): num {
    line mine = mechOf(default.uuid);
    if (line mine != 0) {
        return line mine;
    }
    line here = default.location;
    line best = 0;
    line bestDist = 8;
    repeat (line c to global mCount) {
        if (global mAlive[line c] == 1) {
            line d = vec(global mPos[line c].x - line here.x, 0, global mPos[line c].z - line here.z);
            line dist = line d.len();
            if (line dist < line bestDist) {
                line best = line c;
                line bestDist = line dist;
            }
        }
    }
    return line best;
}

/** Stops the player piloting whatever mech they were riding. */
function leaveMech {
    line c = mechOf(default.uuid);
    if (line c != 0) {
        global mDriver[line c] = "";
        schemaHide(default.uuid);
        fxCockpit(default.uuid, 0);
        cockpitHide(default.uuid);
    }
}

/** Puts the player in the seat of mech c and makes them its driver. */
function sitMech(c: num) {
    if (packLoaded(default.uuid) != 1) {
        default.sendMessage(s"<red>The resource pack has not loaded.</red> <gray>Piloting needs it; try <yellow>@pack</yellow>.");
        return;
    }
    if (line c > global mCount || global mAlive[line c] != 1) {
        default.sendMessage(s"<gray>Mech <white>%var(c)</white> does not exist or is destroyed.");
        return;
    }
    if (global mDriver[line c] != "" && global mDriver[line c] != default.uuid) {
        default.sendMessage(s"<gray>Someone else is piloting mech <white>%var(c)</white>.");
        return;
    }
    leaveMech();
    // Ride first: leaving the old seat fires dismount, which is cancelled
    // only while the player drives a mech.
    default.rideEntity(global mSeat[line c]);
    global mDriver[line c] = default.uuid;
    schemaUpdate(line c);
    fxCockpit(default.uuid, 1);
    cockpitShow(default.uuid, line c);
    default.sendMessage(s"<gray>Piloting mech <white>%var(c)</white>: W/S drive, A/D strafe. Pilots stay in their mech until it is destroyed.");
}

/** Parse parts[index] as a number, or fallback if missing or bad. */
function argNum(parts: list, index: num, fallback: num): num {
    if (parts.len() < index) {
        return fallback;
    }
    return num.parse(parts[index] as str);
}

/** Chat commands: @mech @loadout @sit @clear @cpu @floor @spike @parts @hitbox @hit @hp @splash @party @data @selftest @help, and the
 * pack spike: @pack @hud @menu @model @beep @fx @outline. */
playerevent command {
    ensureInitialized();
    line parts = event.command.split(" ");
    line cmd = (line parts[1] as str).replace("@", "");

    if (line cmd == "mech") {
        ensureLoop();
        // @mech spawns your loadout; @mech <class> that class's default loadout.
        line lo = playerLoadout();
        if (line parts.len() >= 2) {
            line lo = defaultLoadout(line parts[2] as str);
        }
        spawnMech(line lo);
    } else if (line cmd == "loadout") {
        loadoutCommand(line parts);
    } else if (line cmd == "sit") {
        ensureLoop();
        line c = argNum(line parts, 2, 0);
        if (line c == 0) {
            line c = nearestMech();
        }
        if (line c == 0) {
            default.sendMessage(s"<gray>No mech to board: build one with <yellow>@mech</yellow>.");
            return;
        }
        sitMech(line c);
    } else if (line cmd == "clear") {
        clearMechs();
        default.sendMessage(s"<gray>All mechs cleared.");
    } else if (line cmd == "cpu") {
        line cpu = game.cpuUsage;
        default.sendMessage(s"<gray>Plot CPU now: <white>%var(cpu)</white>%, last mech-loop gauge: <white>%var(lastCpu)</white>%.");
    } else if (line cmd == "floor") {
        setFloorHere();
    } else if (line cmd == "spike") {
        ensureLoop();
        spikeCommand(line parts);
    } else if (line cmd == "parts") {
        partsCommand(line parts);
    } else if (line cmd == "hitbox") {
        hitboxCommand(line parts);
    } else if (line cmd == "hit") {
        hitCommand(line parts);
    } else if (line cmd == "party") {
        partyCommand(line parts);
    } else if (line cmd == "data") {
        dataCommand(line parts);
    } else if (line cmd == "selftest") {
        ensureLoop();
        runSelfTest();
    } else if (line cmd == "hp") {
        hpCommand(line parts);
    } else if (line cmd == "splash") {
        splashCommand(line parts);
    } else if (line cmd == "pack") {
        packCommand(line parts);
    } else if (line cmd == "hud") {
        hudCommand(line parts);
    } else if (line cmd == "menu") {
        // @menu toggles the menu (the main screen until MEC-73).
        if (menuIsOpen(default.uuid) == 1) {
            menuClose();
        } else {
            menuOpen("main");
        }
    } else if (line cmd == "model") {
        modelCommand(line parts);
    } else if (line cmd == "beep") {
        beepCommand();
    } else if (line cmd == "fx") {
        fxCommand(line parts);
    } else if (line cmd == "outline") {
        outlineCommand(line parts);
    } else if (line cmd == "help") {
        mechHelp();
    }
}

function mechHelp {
    default.sendMessage(s"<gold><bold>Mechs</bold>");
    default.sendMessage(s"<yellow>@mech [class]</yellow> <gray>spawn your loadout (or a class's default) 6 blocks ahead");
    default.sendMessage(s"<yellow>@loadout [class|main|secondary|armor|aug1|aug2|cosmetic <id> | reset]</yellow> <gray>show or edit your loadout");
    default.sendMessage(s"<yellow>@sit [mech]</yellow> <gray>board that mech, or the nearest one");
    default.sendMessage(s"<yellow>W/S</yellow> <gray>drive forward/back, <yellow>A/D</yellow> strafe; there is no getting out (shift fires the secondary)");
    default.sendMessage(s"<yellow>@floor</yellow> <gray>set the floor plane and arena center at your feet");
    default.sendMessage(s"<yellow>@cpu</yellow> <gray>plot CPU usage; also shown on your action bar each tick");
    default.sendMessage(s"<yellow>@clear</yellow> <gray>remove all mechs");
    default.sendMessage(s"<yellow>@spike</yellow> <gray>CPU test rigs and projectiles (see @spike for options)");
    default.sendMessage(s"<yellow>@parts [slot] [class]</yellow> <gray>list the part catalog");
    default.sendMessage(s"<yellow>@hitbox [mech]</yellow> <gray>show a mech's part hitboxes for 5 seconds");
    default.sendMessage(s"<yellow>@hit [damage]</yellow> <gray>test a ray from your eye against mech hitboxes, optionally damaging the part");
    default.sendMessage(s"<yellow>@hp [mech]</yellow> <gray>list a mech's part HP");
    default.sendMessage(s"<yellow>@splash [damage] [radius]</yellow> <gray>splash damage where your eye ray ends");
    default.sendMessage(s"<yellow>@party [invite <name> | accept | decline | leave | kick <name>]</yellow> <gray>party commands; no argument lists your party");
    default.sendMessage(s"<yellow>@data [credits|points|xp <n> | reset]</yellow> <gray>show your saved player data, add to it, or clear it");
    default.sendMessage(s"<yellow>@selftest</yellow> <gray>run the automated checks (clears all mechs)");
    default.sendMessage(s"<gold><bold>Pack spike</bold>");
    default.sendMessage(s"<yellow>@pack [url|status|clear]</yellow> <gray>send the pack, check it, or remove spike entities");
    default.sendMessage(s"<yellow>@hud [anchor] [palette] | grid | text | off</yellow> <gray>marked glyph or UI text on boss bar 1");
    default.sendMessage(s"<yellow>@menu</yellow> <gray>open or close the menu (mouse to point, left click to choose, right click back)");
    default.sendMessage(s"<yellow>@model [party]</yellow> <gray>test part swinging about its joint");
    default.sendMessage(s"<yellow>@beep</yellow> <gray>custom sound");
    default.sendMessage(s"<yellow>@fx zoom+shake+tint+gray [strength%] [party]|off</yellow> <gray>screen effects via the marker");
    default.sendMessage(s"<yellow>@outline [party party party]</yellow> <gray>three glowing cubes in party colors");
}

playerevent join {
    default.setToCreativeMode();
    restartLoop();
    pdLoad(default.uuid);
    global playerNames[default.uuid] = default.name;
    settingsApply(default.uuid);
    packJoin();
    packSend();
    privHideFrom(default.uuid);
    default.sendMessage(s"<gold>Mechs <gray>- type <yellow>@help</yellow> for commands.");
    selfTestJoin();
}

playerevent leave {
    fxDrop(default.uuid);
    partyDrop(default.uuid);
    global dropPending.remove(default.uuid);
    global modeOf.remove(default.uuid);
}

/** Pilots never leave their mech (owner, MEC-95): dismounting is cancelled
 * while the player drives one. Shift (sneak) is the secondary gun's trigger
 * instead. The seat goes only when the mech is destroyed or cleared. Menu
 * seats still close on sneak. */
playerevent dismount {
    if (mechOf(default.uuid) != 0) {
        event.cancel();
        return;
    }
    menuClose();
}
