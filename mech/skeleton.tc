// Class skeletons (PLAN.md, Mech classes): the fixed parts of each class and
// where they sit, drawn with placeholder models. Every part is one item
// display: mech:skel_box (a unit box centered on its joint) for hull and
// torso, mech:skel_segment (a unit box from its joint along +z) for guns and
// leg segments; the display matrix scales and points it. Item displays turn
// their model 180 degrees about y before the matrix, so the segment model is
// built along model -z to come out along +z. Legs stand in a rest
// pose until gait and IK (MEC-27/28) move the feet.
//
// Local offsets are (left, up, forward) from the mech's ground point, in
// blocks. Every matrix is right-handed (left = up x forward), so models are
// never mirrored or drawn inside out.

/** All part displays, mech by mech, in order: hull, torso, main gun,
 * secondary gun, augment modules 1 and 2, then thigh and shin for each leg. Mech c owns
 * mPartEnt[mPartStart[c] .. mPartStart[c] + mPartCount[c] - 1]. */
declare global mPartEnt: list[str];
declare global mPartStart: list[num];
declare global mPartCount: list[num];
/** Pose each mech was last drawn at; unchanged mechs skip their writes. */
declare global mDrawnPos: list[vec];
declare global mDrawnYaw: list[num];
/** Seat height above the ground point: the pilot's eye sits just above the
 * torso top (eye = seat + 0.6 interaction height + 1.6 eye height). */
declare global mSeatUp: list[num];

/** Skeleton of a class: ride (hull center height), torso offset and size,
 * main and secondary gun mounts, hips and rest feet (one per leg), thigh and
 * shin lengths, leg width, knee pole (local; knees bend toward it) and part
 * colors. Sprinters are slimmer walkers: same layout, thinner parts. */
function classSkeleton(cls: str): dict {
    if (cls == "sprinter") {
        return {
            ride: 2.1, torso: vec(0, 3.0, -0.1), torsoSize: vec(1.2, 0.5, 1.4),
            mainMount: vec(-0.75, 3.0, 0.3), secMount: vec(0.75, 3.0, 0.3),
            hips: [vec(0.55, 1.55, 0), vec(-0.55, 1.55, 0)], feet: [vec(0.7, 0, 0.2), vec(-0.7, 0, 0.2)],
            thigh: 1.2, shin: 1.3, legW: 0.22, pole: vec(0, 0, -1),
            colors: [0xC9CED6, 0xA9B0BA, 0x4A5058, 0x7C838D]
        };
    }
    if (cls == "crawler") {
        return {
            ride: 1.4, torso: vec(0, 2.3, 0), torsoSize: vec(1.8, 0.6, 1.8),
            mainMount: vec(0, 2.4, 0.6), secMount: vec(0.95, 2.3, 0),
            hips: [vec(1.4, 1.1, 1.1), vec(-1.4, 1.1, 1.1), vec(1.4, 1.1, 0), vec(-1.4, 1.1, 0), vec(1.4, 1.1, -1.1), vec(-1.4, 1.1, -1.1)],
            feet: [vec(3.0, 0, 1.54), vec(-3.0, 0, 1.54), vec(3.0, 0, 0), vec(-3.0, 0, 0), vec(3.0, 0, -1.54), vec(-3.0, 0, -1.54)],
            thigh: 1.6, shin: 1.9, legW: 0.32, pole: vec(0, 1, 0),
            colors: [0x7E8466, 0x666B52, 0x3A3D33, 0x55594A]
        };
    }
    if (cls == "spider") {
        return {
            ride: 1.0, torso: vec(0, 1.6, 0), torsoSize: vec(0.8, 0.4, 0.8),
            mainMount: vec(0, 1.7, 0.3), secMount: vec(0.45, 1.6, 0.1),
            hips: [vec(0.6, 0.8, 0.6), vec(-0.6, 0.8, 0.6), vec(0.6, 0.8, -0.6), vec(-0.6, 0.8, -0.6)],
            feet: [vec(1.8, 0, 1.6), vec(-1.8, 0, 1.6), vec(1.8, 0, -1.6), vec(-1.8, 0, -1.6)],
            thigh: 1.1, shin: 1.4, legW: 0.2, pole: vec(0, 1, 0),
            colors: [0x4B4F57, 0x3B3E45, 0x2C2E33, 0x60656E]
        };
    }
    // Walker: tall biped, reverse knees (bend backward).
    return {
        ride: 2.6, torso: vec(0, 3.7, -0.1), torsoSize: vec(1.5, 0.6, 1.7),
        mainMount: vec(-0.95, 3.6, 0.4), secMount: vec(0.95, 3.6, 0.4),
        hips: [vec(0.75, 1.9, 0), vec(-0.75, 1.9, 0)], feet: [vec(0.9, 0, 0.25), vec(-0.9, 0, 0.25)],
        thigh: 1.4, shin: 1.6, legW: 0.35, pole: vec(0, 0, -1),
        colors: [0x8A9099, 0x6F757E, 0x3C4148, 0x585E66]
    };
}

/** The mech's left axis for facing f: up x f, so (left, up, f) is right-handed. */
function leftOf(f: vec): vec {
    return vec(f.z, 0, 0 - f.x);
}

/** World point of a local (left, up, forward) offset from ground point base. */
function toWorld(base: vec, f: vec, o: vec): vec {
    return base + leftOf(f) * o.x + vec(0, o.y, 0) + f * o.z;
}

/** Row-major display matrix from three columns, no translation (the display
 * is teleported to the part's joint). */
function columnsMatrix(c0: vec, c1: vec, c2: vec): list {
    return [
        c0.x, c1.x, c2.x, 0,
        c0.y, c1.y, c2.y, 0,
        c0.z, c1.z, c2.z, 0,
        0, 0, 0, 1
    ];
}

/** Columns for a mech:skel_box of size (side, up, forward) facing f. */
function boxCols(f: vec, size: vec): list {
    return [leftOf(f) * size.x, vec(0, size.y, 0), f * size.z];
}

/** Columns for a mech:skel_segment of width w from its joint to joint + d.
 * side x (dn x side) = dn, so the columns are right-handed. */
function segCols(d: vec, w: num): list {
    line dn = d.setLength(1);
    line side = line dn.cross(vec(0, 1, 0));
    if (line side.len() < 0.01) {
        line side = vec(1, 0, 0);
    }
    line side = line side.setLength(1);
    return [line side * w, line dn.cross(line side) * w, d];
}

/** Two-bone IK: the knee for a thigh l1 from hip and a shin l2 to foot,
 * bending toward pole (world direction). A foot out of reach straightens
 * the leg toward it. Gait (MEC-27/28) reuses this with moving feet. */
function kneeOf(hip: vec, foot: vec, l1: num, l2: num, pole: vec): vec {
    line hf = foot - hip;
    line d = num.clamp(line hf.len(), num.abs(l1 - l2) + 0.01, l1 + l2 - 0.01);
    line dir = line hf.setLength(1);
    // Law of cosines: distance along hip->foot to the knee's foot point.
    line a = (l1 * l1 - l2 * l2 + line d * line d) / (2 * line d);
    line h = num.root(num.max(l1 * l1 - line a * line a, 0));
    line bend = pole - line dir * pole.dot(line dir);
    if (line bend.len() < 0.01) {
        line bend = vec(0, 1, 0);
    }
    return hip + line dir * line a + line bend.setLength(1) * line h;
}

/** Spawns one placeholder part display with a model and tint, and records it
 * with its hitbox kind and role (combat/hitbox.tc). */
function spawnPart(at: vec, model: str, color: num, kind: num, role: str) {
    line part = item("stone").setModel(model).setModelDataNumbers(color, type="Colors");
    game.spawnItemDisplay(loc(at.x, at.y, at.z), line part);
    lastEntity.setDisplayTeleportDuration(1);
    global mPartEnt.append(lastEntity.uuid);
    addHitbox(at, kind, role);
}

/** Local (left, up, forward) mount of augment module n (1 or 2) on class
 * cls with hull size hull (mSize order: forward, up, side): side pods on the
 * hull flanks, behind center. */
function augMountOf(cls: str, hull: vec, n: num): vec {
    line side = 1;
    if (n == 2) {
        line side = -1;
    }
    return vec(line side * (hull.z * 0.5 + 0.25), classSkeleton(cls)["ride"] as num, 0 - hull.x * 0.2);
}

/** Augment module n's mount on mech c. */
function augMount(c: num, n: num): vec {
    return augMountOf(global mClass[c], global mSize[c], n);
}

/** Model and tint of part i (0 = hull) of class cls, in display order:
 * [model, color]. Game tints keep the low 2 bits of each channel clear; set
 * they mark a menu preview (core/item.vsh). */
function partVisual(cls: str, i: num): list {
    line colors = classSkeleton(cls)["colors"] as list;
    line model = "mech:skel_segment";
    line color = line colors[4] as num;
    if (i == 0 || i == 1 || i == 4 || i == 5) {
        line model = "mech:skel_box";
    }
    if (i == 0) {
        line color = line colors[1] as num;
    } else if (i == 1) {
        line color = line colors[2] as num;
    } else if (i <= 5) {
        line color = line colors[3] as num;
    }
    return [line model, line color & 0xFCFCFC];
}

/** Number of parts of class cls: hull, torso, two guns, two modules, and a
 * thigh and shin per leg. */
function partTotal(cls: str): num {
    return 6 + 2 * (classSkeleton(cls)["hips"] as list).len();
}

/** Spawns mech c's part displays (it must already have mPos, mClass, mSize
 * and mLoadout), in display order: hull, torso, main gun, secondary gun,
 * augment modules 1 and 2, then thigh and shin for each leg. */
function spawnParts(c: num) {
    line sk = classSkeleton(global mClass[c]);
    line at = global mPos[c];
    global mPartStart.append(global mPartEnt.len() + 1);
    line roles = ["hull", "torso", "main", "secondary", "aug1", "aug2"];
    line kinds = [1, 1, 2, 2, 1, 1];
    repeat (line i to partTotal(global mClass[c])) {
        line look = partVisual(global mClass[c], line i - 1);
        if (line i <= 6) {
            spawnPart(at, line look[1] as str, line look[2] as num, line kinds[line i] as num, line roles[line i] as str);
        } else {
            line leg = num.floor((line i - 5) / 2);
            if ((line i - 7) % 2 == 0) {
                spawnPart(at, line look[1] as str, line look[2] as num, 3, "thigh%var(leg)");
            } else {
                spawnPart(at, line look[1] as str, line look[2] as num, 3, "shin%var(leg)");
            }
        }
    }
    global mPartCount.append(global mPartEnt.len() + 1 - global mPartStart[c]);
    global mDrawnPos.append(vec(0, -9999, 0));
    global mDrawnYaw.append(0);
    line torso = line sk["torso"] as vec;
    line top = line torso.y + (line sk["torsoSize"] as vec).y * 0.5;
    global mSeatUp.append(line top + 0.3 - 2.2);
    addBound(c, line top);
    addDamageState(c);
    addLossState(c);
}

/** Moves part i of mech c to world point at with matrix columns cols, and
 * records its hitbox there. Destroyed parts are skipped. */
function placePart(c: num, i: num, at: vec, cols: list) {
    line k = global mPartStart[c] + i;
    // Destroyed parts are debris now (combat/loss.tc).
    if (global hbHp[line k] <= 0) {
        return;
    }
    line c0 = cols[1] as vec;
    line c1 = cols[2] as vec;
    line c2 = cols[3] as vec;
    select entitiesByName(global mPartEnt[line k]);
    selectedEntity.teleport(loc(at.x, at.y, at.z));
    selectedEntity.setDisplayTransformationMatrix(columnsMatrix(line c0, line c1, line c2));
    selectedEntity.setDisplayInterpolation(1, 0);
    select reset;
    setHitbox(line k, at, line c0, line c1, line c2);
}

/** Horizontal reach of a class: the farthest rest foot or hull corner, for
 * the mech's bounding radius. */
function skeletonReach(cls: str, hull: vec): num {
    line reach = num.root(hull.x * hull.x + hull.z * hull.z) * 0.5;
    for (line foot of classSkeleton(cls)["feet"] as list) {
        line fv = line foot as vec;
        line reach = num.max(line reach, num.root(line fv.x * line fv.x + line fv.z * line fv.z));
    }
    return line reach;
}

/** Draws every part of mech c in its rest pose, unless it has not moved or
 * turned since it was last drawn. Parts hang off the ground point under the
 * chassis position. */
function drawParts(c: num) {
    line pos = global mPos[c];
    line base = vec(line pos.x, global floorY, line pos.z);
    line yaw = global mYaw[c];
    if ((line base - global mDrawnPos[c]).len() < 0.001 && num.abs(line yaw - global mDrawnYaw[c]) < 0.001) {
        return;
    }
    global mDrawnPos[c] = line base;
    global mDrawnYaw[c] = line yaw;

    line poses = skeletonPose(global mClass[c], global mLoadout[c], global mSize[c], line base, global mF[c], 1);
    repeat (line i to line poses.len()) {
        line pose = line poses[line i] as list;
        placePart(c, line i - 1, line pose[1] as vec, [line pose[2], line pose[3], line pose[4]]);
    }
    global mBoundAt[c] = line base + vec(0, global mBoundUp[c], 0);
}

/** Every part's pose for class cls with loadout lo and hull size hull
 * (mSize order), standing at ground point base facing f, scaled by s about
 * base: [joint, column x, column y, column z] per part in display order.
 * Legs stand in their rest pose. Mechs draw with s = 1; menu previews
 * (ui/preview.tc) draw small copies. */
function skeletonPose(cls: str, lo: dict, hull: vec, base: vec, f: vec, s: num): list {
    line sk = classSkeleton(cls);
    line out = [];
    // hull is (forward, up, side); boxes take (side, up, forward).
    line out.append(skelPart(base, toWorld(base, f, vec(0, line sk["ride"] as num, 0)), boxCols(f, vec(hull.z, hull.y, hull.x)), s));
    line out.append(skelPart(base, toWorld(base, f, line sk["torso"] as vec), boxCols(f, line sk["torsoSize"] as vec), s));
    // Guns point along the hull until torso traverse (MEC-24) aims them.
    line mainBox = partRow(lo["main"] as str)["size"] as vec;
    line secBox = partRow(lo["secondary"] as str)["size"] as vec;
    line out.append(skelPart(base, toWorld(base, f, line sk["mainMount"] as vec), segCols(f * line mainBox.z, line mainBox.x), s));
    line out.append(skelPart(base, toWorld(base, f, line sk["secMount"] as vec), segCols(f * line secBox.z, line secBox.x), s));
    line out.append(skelPart(base, toWorld(base, f, augMountOf(cls, hull, 1)), boxCols(f, partRow(lo["aug1"] as str)["size"] as vec), s));
    line out.append(skelPart(base, toWorld(base, f, augMountOf(cls, hull, 2)), boxCols(f, partRow(lo["aug2"] as str)["size"] as vec), s));

    line hips = line sk["hips"] as list;
    line feet = line sk["feet"] as list;
    line thigh = line sk["thigh"] as num;
    line shin = line sk["shin"] as num;
    line w = line sk["legW"] as num;
    line pl = line sk["pole"] as vec;
    line pole = leftOf(f) * line pl.x + vec(0, line pl.y, 0) + f * line pl.z;
    repeat (line i to line hips.len()) {
        line hip = toWorld(base, f, line hips[line i] as vec);
        line foot = toWorld(base, f, line feet[line i] as vec);
        line knee = kneeOf(line hip, line foot, line thigh, line shin, line pole);
        line out.append(skelPart(base, line hip, segCols(line knee - line hip, line w), s));
        line out.append(skelPart(base, line knee, segCols(line foot - line knee, line w * 0.8), s));
    }
    return line out;
}

/** One part's pose [joint, columns...] scaled by s about base. */
function skelPart(base: vec, at: vec, cols: list, s: num): list {
    return [base + (at - base) * s, (cols[1] as vec) * s, (cols[2] as vec) * s, (cols[3] as vec) * s];
}
