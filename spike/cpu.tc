// Stage 1 CPU spike: crawler-sized rigs (16 item displays, six legs on a
// tripod gait with two-bone IK) and live projectiles with segment tests.
// Measures the per-mech and per-projectile cost with @cpu; delete this
// folder once the budgets are recorded in PLAN.md.

/** Rigs, indexed 1..rCount. Displays are 16 per rig in rEnt, rig r owning
 * rEnt[(r-1)*16+1 .. r*16]: body, turret, gun, secondary, then a thigh and a
 * shin for each of the six legs. */
declare global rCount: num;
/** Angle around the rig's ring, radians. */
declare global rAng: list[num];
/** Ring radius the rig walks around the arena center. */
declare global rRing: list[num];
/** Gait phase 0..1. */
declare global rPhase: list[num];
declare global rPos: list[vec];
declare global rEnt: list[str];

/** Projectiles, indexed 1..pCount. */
declare global pCount: num;
declare global pPos: list[vec];
declare global pVel: list[vec];
declare global pLife: list[num];
declare global pEnt: list[str];

/** Switches: 1 = on. */
declare global spikeLod: num;
declare global spikeProbes: num;
declare global spikeRide: num;
/** Ticks since the spike started, projectile hits, smoothed CPU. */
declare global spikeTicks: num;
declare global spikeHits: num;
declare global cpuAvg: num;

/** Leg segment lengths and body height above the floor. */
function thighLen(): num {
    return 1.4;
}

function shinLen(): num {
    return 1.8;
}

function bodyHeight(): num {
    return 1.6;
}

/** @spike subcommands. */
function spikeCommand(parts: list) {
    ensureFloor();
    line sub = "";
    if (parts.len() >= 2) {
        line sub = parts[2] as str;
    }
    if (line sub == "rigs") {
        setRigs(argNum(parts, 3, 0));
    } else if (line sub == "shots") {
        setShots(argNum(parts, 3, 0));
    } else if (line sub == "lod") {
        global spikeLod = 1 - global spikeLod;
        setRigs(global rCount);
    } else if (line sub == "probes") {
        global spikeProbes = 1 - global spikeProbes;
    } else if (line sub == "ride") {
        global spikeRide = 1 - global spikeRide;
        setRigs(global rCount);
    } else if (line sub == "clear") {
        setRigs(0);
        setShots(0);
    }
    line rigs = global rCount;
    line shots = global pCount;
    line lod = global spikeLod;
    line probes = global spikeProbes;
    line ride = global spikeRide;
    default.sendMessage(s"<gray>Spike: rigs <white>%var(rigs)</white>, shots <white>%var(shots)</white>, lod <white>%var(lod)</white>, probes <white>%var(probes)</white>, ride <white>%var(ride)</white>.");
    default.sendMessage(s"<gray><yellow>@spike rigs N</yellow>, <yellow>shots N</yellow>, <yellow>lod</yellow>, <yellow>probes</yellow>, <yellow>ride</yellow>, <yellow>clear</yellow>");
}

/** Removes every rig, then spawns n fresh ones with the current switches. */
function setRigs(n: num) {
    repeat (line i to global rCount * 16) {
        select entitiesByName(global rEnt[line i]);
        selectedEntity.remove();
        select reset;
    }
    global rCount = 0;
    global rAng = [];
    global rRing = [];
    global rPhase = [];
    global rPos = [];
    global rEnt = [];
    repeat (line i to n) {
        spawnRig();
    }
    global cpuAvg = 0;
}

/** Spawns one rig on its own ring around the arena center. */
function spawnRig {
    global rCount += 1;
    line r = global rCount;
    global rAng.append(line r * 2.4);
    global rRing.append(5 + (line r % 4) * 4);
    global rPhase.append((line r * 0.37) % 1);
    line at = vec(global arenaX, global floorY + bodyHeight(), global arenaZ);
    global rPos.append(line at);
    line here = loc(line at.x, line at.y, line at.z);
    line root = "";
    line step = 1;
    if (global spikeLod == 1) {
        line step = 2;
    }
    repeat (line j to 16) {
        line look = item("iron_block");
        if (line j > 4) {
            line look = item("gray_concrete");
        }
        game.spawnItemDisplay(line here, line look);
        global rEnt.append(lastEntity.uuid);
        select entitiesByName(lastEntity.uuid);
        selectedEntity.setDisplayTeleportDuration(line step);
        if (line j == 1) {
            line root = lastEntity.uuid;
        } else if (global spikeRide == 1) {
            selectedEntity.ride(line root);
        }
        select reset;
    }
}

/** Removes every projectile, then fires n fresh ones. */
function setShots(n: num) {
    repeat (line i to global pCount) {
        select entitiesByName(global pEnt[line i]);
        selectedEntity.remove();
        select reset;
    }
    global pCount = 0;
    global pPos = [];
    global pVel = [];
    global pLife = [];
    global pEnt = [];
    repeat (line i to n) {
        global pCount += 1;
        global pPos.append(vec(global arenaX, global floorY + 2, global arenaZ));
        global pVel.append(vec(0, 0, 0));
        global pLife.append(0);
        game.spawnItemDisplay(loc(global arenaX, global floorY + 2, global arenaZ), item("blaze_rod"));
        global pEnt.append(lastEntity.uuid);
        select entitiesByName(lastEntity.uuid);
        selectedEntity.setDisplayTeleportDuration(1);
        select reset;
        refire(global pCount);
    }
}

/** Fires projectile p from a random rig's gun toward another random rig. */
function refire(p: num) {
    global pLife[p] = 40;
    if (global rCount < 2) {
        global pPos[p] = vec(global arenaX, global floorY + 2, global arenaZ);
        global pVel[p] = vec(num.random(-1, 1), 0.3, num.random(-1, 1)).setLength(2);
        return;
    }
    line a = num.floor(num.random(1, global rCount + 0.999));
    line b = num.floor(num.random(1, global rCount + 0.999));
    if (line b == line a) {
        line b = line a % global rCount + 1;
    }
    line from = global rPos[line a] + vec(0, 1, 0);
    line aim = global rPos[line b];
    global pPos[p] = line from;
    global pVel[p] = (line aim - line from).setLength(3) + vec(0, 0.15, 0);
}

/** Rotation + scale columns for a box of size (side, up, forward) facing f,
 * centered at offset off from the display origin. */
function boxMatrix(f: vec, size: vec, off: vec): list {
    line r = vec(0 - f.z, 0, f.x);
    line c0 = line r * size.x;
    line c1 = vec(0, size.y, 0);
    line c2 = f * size.z;
    return [
        line c0.x, line c1.x, line c2.x, off.x,
        line c0.y, line c1.y, line c2.y, off.y,
        line c0.z, line c1.z, line c2.z, off.z,
        0, 0, 0, 1
    ];
}

/** Matrix for a w-thick segment from a to b, relative to display origin e. */
function segMatrix(a: vec, b: vec, e: vec, w: num): list {
    line d = b - a;
    line dn = line d.setLength(1);
    line side = line dn.cross(vec(0, 1, 0));
    if (line side.len() < 0.01) {
        line side = vec(1, 0, 0);
    }
    line side = line side.setLength(1);
    // side x (dn x side) = dn, so (c0, c1, c2) is right-handed.
    line c0 = line side * w;
    line c1 = line dn.cross(line side) * w;
    line c2 = line d;
    line t = (a + b) * 0.5 - e;
    return [
        line c0.x, line c1.x, line c2.x, line t.x,
        line c0.y, line c1.y, line c2.y, line t.y,
        line c0.z, line c1.z, line c2.z, line t.z,
        0, 0, 0, 1
    ];
}

/** Writes matrix m to rig display index i; teleports it to `at` unless it
 * rides the rig's root display. */
function putDisplay(i: num, root: num, at: vec, m: list, interp: num) {
    select entitiesByName(global rEnt[i]);
    if (root == 1 || global spikeRide != 1) {
        selectedEntity.teleport(loc(at.x, at.y, at.z));
    }
    selectedEntity.setDisplayTransformationMatrix(m);
    selectedEntity.setDisplayInterpolation(interp, 0);
    select reset;
}

/** One tick of rig r: walk its ring, step the legs, solve IK, draw. */
function rigTick(r: num, interp: num) {
    // Chassis: walk the ring at 0.25 blocks per tick of game time.
    global rAng[r] = global rAng[r] + 0.25 * interp / global rRing[r];
    line ang = global rAng[r];
    line ring = global rRing[r];
    line pos = vec(global arenaX + num.cosr(line ang) * line ring, global floorY + bodyHeight(), global arenaZ + num.sinr(line ang) * line ring);
    global rPos[r] = line pos;
    line f = vec(0 - num.sinr(line ang), 0, num.cosr(line ang));
    line side = vec(0 - f.z, 0, f.x);
    global rPhase[r] = (global rPhase[r] + 0.05 * interp) % 1;
    line base = (r - 1) * 16;

    // Hull, turret, main gun, secondary.
    putDisplay(line base + 1, 1, line pos, boxMatrix(line f, vec(2.4, 0.9, 3), vec(0, 0, 0)), interp);
    putDisplay(line base + 2, 0, line pos, boxMatrix(line f, vec(1.4, 0.6, 1.4), vec(0, 0.75, 0)), interp);
    putDisplay(line base + 3, 0, line pos, boxMatrix(line f, vec(0.3, 0.3, 2.6), vec(0, 0.8, 0) + f * 1.6), interp);
    putDisplay(line base + 4, 0, line pos, boxMatrix(line f, vec(0.25, 0.25, 1.2), vec(0, 0.5, 0) + line side * 0.9 + f * 1.2), interp);

    // Legs 1-3 on the left, 4-6 on the right; alternating tripods.
    line l1 = thighLen();
    line l2 = shinLen();
    repeat (line j to 6) {
        line k = (line j - 1) % 3;
        line s = -1;
        if (line j > 3) {
            line s = 1;
        }
        line fo = 1.1 - 1.1 * line k;
        line group = (line k + (line s + 1) / 2) % 2;
        line ph = (global rPhase[r] + line group * 0.5) % 1;
        line along = 0;
        line lift = 0;
        if (line ph < 0.5) {
            line along = 0.9 * (0.5 - line ph * 2);
        } else {
            line u = (line ph - 0.5) * 2;
            line along = 0.9 * (line u - 0.5);
            line lift = 0.6 * num.sinr(3.1416 * line u);
        }
        line hip = line pos + f * line fo + line side * (line s * 0.8) + vec(0, 0.2, 0);
        line foot = line pos + f * (line fo * 1.3 + line along) + line side * (line s * 2.6);
        line foot.y = global floorY + line lift;

        // Two-bone IK, knee bent upward.
        line d = line foot - line hip;
        line len = num.clamp(line d.len(), 0.2, line l1 + line l2 - 0.01);
        line dn = line d.setLength(1);
        line a = (line l1 * line l1 + line len * line len - line l2 * line l2) / (2 * line len);
        line h = num.root(num.max(line l1 * line l1 - line a * line a, 0));
        line perp = vec(0, 1, 0) - line dn * line dn.y;
        if (line perp.len() < 0.01) {
            line perp = line side;
        }
        line perp = line perp.setLength(1);
        line knee = line hip + line dn * line a + line perp * line h;

        putDisplay(line base + 3 + line j * 2, 0, line pos, segMatrix(line hip, line knee, line pos, 0.35), interp);
        putDisplay(line base + 4 + line j * 2, 0, line pos, segMatrix(line knee, line foot, line pos, 0.28), interp);
    }

    // Terrain probes the real chassis will need: under the body, ahead,
    // and under one foot.
    if (global spikeProbes == 1) {
        line down = game.raycast(loc(line pos.x, line pos.y, line pos.z, 90, 0), 4, blockCollision="Solid blocks");
        line ahead = game.raycast(loc(line pos.x, line pos.y, line pos.z).setDirection(line f), 3, blockCollision="Solid blocks");
        line under = game.raycast(loc(line pos.x + line side.x * 2.6, line pos.y, line pos.z + line side.z * 2.6, 90, 0), 4, blockCollision="Solid blocks");
    }
}

/** One tick of projectile p: move, fall, test the segment against rigs and
 * terrain, refire on a hit or when it expires. */
function shotTick(p: num) {
    line old = global pPos[p];
    line vel = global pVel[p];
    line pos = line old + line vel;
    global pPos[p] = line pos;
    global pVel[p] = line vel - vec(0, 0.02, 0);
    global pLife[p] = global pLife[p] - 1;
    line hit = 0;
    // Segment vs each rig's bounding sphere: closest point on old..pos.
    line seg = line pos - line old;
    line segLen2 = seg.dot(seg);
    repeat (line r to global rCount) {
        if (line hit == 0) {
            line t = 0;
            if (line segLen2 > 0.001) {
                line t = num.clamp((global rPos[line r] - line old).dot(seg) / line segLen2, 0, 1);
            }
            line close = line old + seg * line t - global rPos[line r];
            if (line close.dot(line close) < 3.24) {
                line hit = 1;
            }
        }
    }
    // Terrain along the segment: the ray stops short of the step on a hit.
    if (line hit == 0) {
        line reach = line vel.len();
        line origin = loc(line old.x, line old.y, line old.z).setDirection(line vel);
        line stop = game.raycast(line origin, line reach, blockCollision="Solid blocks");
        if (line stop.getDistance(line origin) < line reach - 0.01) {
            line hit = 1;
        }
    }
    if (line hit == 1) {
        global spikeHits += 1;
    }
    if (line hit == 1 || global pLife[p] <= 0 || line pos.y < global floorY) {
        refire(p);
        line pos = global pPos[p];
    }
    select entitiesByName(global pEnt[p]);
    selectedEntity.teleport(loc(line pos.x, line pos.y, line pos.z));
    select reset;
}

/** Advances every rig and projectile one tick; LOD updates half the rigs
 * each tick with 2-tick interpolation. */
function spikeStep {
    global spikeTicks += 1;
    repeat (line r to global rCount) {
        if (global spikeLod != 1) {
            rigTick(line r, 1);
        } else if ((global spikeTicks + line r) % 2 == 0) {
            rigTick(line r, 2);
        }
    }
    repeat (line p to global pCount) {
        shotTick(line p);
    }
}
