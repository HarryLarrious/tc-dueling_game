// Queue selector screen (MEC-74), after references/ui references/menu/
// mock up/queue selector.png: the top bar and three cards, TRAINING GROUND,
// RANKED (Extraction, the tall middle card) and CASUAL (FFA), each with what
// is at stake and how many mechs are on the map. Clicking a card queues the
// party (game/queue.tc).

/** Card of mode `mode` at x: panel, title button and two lines of detail. */
function queueCard(mode: str, title: str, line1: str, line2: str, x: num, h: num): list {
    return [
        menuPanel("card_%var(mode)", x, 15, 130, h, 2, 0.4),
        menuButton("join_%var(mode)", title, x, 15, 130, h, "join %var(mode)"),
        menuLabel("info1_%var(mode)", line1, "text_s", x, 15 + h / 2 - 34, 1),
        menuLabel("info2_%var(mode)", line2, "text_s", x, 15 + h / 2 - 22, 1)
    ];
}

/** Widgets of the queue selector for the player. */
function queueScreen(uuid: str): list {
    line cr = playerCredits(uuid);
    line pts = playerPoints(uuid);
    line live = liveMechs();
    line cap = mechCap();
    line n = partyMembers(uuid).len();
    line out = [
        menuPanel("topbar", 0, -160, 470, 26, 2, 0.6),
        menuButton("home", "BACK", -195, -160, 60, 16, "home"),
        menuButton("settings", "SETTINGS", -125, -160, 66, 16, "settings"),
        menuButton("shop", "SHOP", 90, -160, 50, 16, "shop"),
        menuLabel("credits", "CREDITS %var(cr)", "text_s", 150, -160, 4),
        menuLabel("points", "POINTS %var(pts)", "text_s", 205, -160, 6),
        menuLabel("title", "CHOOSE A QUEUE", "text", 0, -120, 3),
        menuLabel("room", "MAP %var(live)/%var(cap) MECHS   PARTY OF %var(n)", "text_s", 0, 135, 1)
    ];
    for (line card of [
        queueCard("training", "TRAINING GROUND", "PRACTICE AGAINST AI", "NO REWARDS", -150, 180),
        queueCard("extraction", "RANKED", "EXTRACTION RAID", "CARRY POINTS OUT", 0, 210),
        queueCard("ffa", "CASUAL", "FREE FOR ALL", "NOTHING AT STAKE", 150, 180)
    ]) {
        for (line w of line card as list) {
            line out.append(line w);
        }
    }
    return line out;
}

/** Queue actions ("join <mode>"); 1 when the action was one. */
function queueAction(action: str): num {
    if (action.find("join ") != 1) {
        return 0;
    }
    line err = queueJoin(default.uuid, action.replace("join ", ""));
    if (line err != "") {
        default.sendMessage(s"<red>%var(err)");
    }
    return 1;
}
