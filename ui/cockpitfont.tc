// Generated by pack/src/cockpit_assets.py; do not edit.
// Cockpit glyphs (font mech:cockpit): [char, x, advance] in canvas units from
// their anchor; vertical places are baked into the glyphs.

/** Frame corners of class cls: top-left, top-right, bottom-left,
 * bottom-right (anchors 0, 2, 6, 8). */
function frameGlyphs(cls: str): list {
    if (cls == "walker") {
        return [["\uE200", -1, 108], ["\uE201", -113, 115], ["\uE202", -1, 108], ["\uE203", -113, 115]];
    }
    if (cls == "sprinter") {
        return [["\uE204", -1, 114], ["\uE205", -113, 115], ["\uE206", -1, 114], ["\uE207", -113, 115]];
    }
    if (cls == "crawler") {
        return [["\uE208", -1, 114], ["\uE209", -113, 115], ["\uE20A", -1, 114], ["\uE20B", -113, 115]];
    }
    if (cls == "spider") {
        return [["\uE20C", -1, 64], ["\uE20D", -113, 115], ["\uE20E", -1, 64], ["\uE20F", -113, 115]];
    }
    return [];
}

/** Crosshair of gun id (anchor 4), or the railgun's for an unknown gun. */
function crosshairGlyph(gun: str): list {
    if (gun == "autocannon") {
        return ["\uE241", -17, 31];
    }
    if (gun == "lmg") {
        return ["\uE242", -17, 30];
    }
    if (gun == "cal50") {
        return ["\uE243", -17, 25];
    }
    if (gun == "grenade") {
        return ["\uE244", -17, 24];
    }
    if (gun == "burst") {
        return ["\uE245", -17, 28];
    }
    return ["\uE240", -17, 30];
}

/** The gun reticle glyph (font mech:reticle). */
function reticleChar(): str {
    return "\uE260";
}
