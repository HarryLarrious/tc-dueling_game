    if (cls == "walker") {
        return [["\uE100", 17, 39], ["\uE101", 19, 35], ["\uE102", 55, 13], ["\uE103", 5, 13], ["\uE104", 5, 13], ["\uE105", 55, 13], ["\uE106", 19, 15], ["\uE107", 19, 15], ["\uE108", 39, 15], ["\uE109", 39, 15]];
