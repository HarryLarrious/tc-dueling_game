    }
    if (cls == "crawler") {
        return [["\uE140", 13, 47], ["\uE141", 19, 35], ["\uE142", 30, 13], ["\uE143", 5, 13], ["\uE144", 1, 13], ["\uE145", 59, 13], ["\uE146", 15, 17], ["\uE147", -1, 17], ["\uE148", 41, 17], ["\uE149", 57, 17], ["\uE14A", 15, 17], ["\uE14B", -1, 17], ["\uE14C", 41, 17], ["\uE14D", 57, 17], ["\uE14E", 15, 17], ["\uE14F", -1, 17], ["\uE150", 41, 17], ["\uE151", 57, 17]];
    }
    if (cls == "spider") {
        return [["\uE160", 19, 35], ["\uE161", 23, 27], ["\uE162", 30, 13], ["\uE163", 9, 13], ["\uE164", 5, 13], ["\uE165", 55, 13], ["\uE166", 17, 17], ["\uE167", -1, 19], ["\uE168", 39, 17], ["\uE169", 55, 19], ["\uE16A", 17, 17], ["\uE16B", -1, 19], ["\uE16C", 39, 17], ["\uE16D", 55, 19]];
    }
    return [];
}

