// Automated self-test (MEC-100): runs when a player enters play mode (while
// selfTestOnJoin() is 1) or on @selftest, and prints one chat line per check:
// "MECHTEST PASS <name>" or "MECHTEST FAIL <name> got <x> want <y>", then
// "MECHTEST DONE <passed> passed <failed> failed". Chat lands in the client
// log, so tests run and read back without anyone typing. The test clears all
// mechs before and after. New features add their checks here.

/** Checks passed and failed in the current run. */
declare global testPass: num;
declare global testFail: num;

/** 1 = run the self-test whenever a player joins (enters play mode). */
function selfTestOnJoin(): num {
    return 1;
}

/** Visual demo after the checks: "" none, "hud" (the demo HUD for 10 s),
 * "fx" (each screen effect for 12 s), "cockpit" (frame, crosshair and gun
 * reticle for 15 s), "menu" (the main menu for 15 s), "custom" (the
 * customizer for 15 s), "settings" (the settings screen for 15 s) or
 * "party" (the main screen with a party of three and an invite, 15 s) or
 * "queue" (the queue selector, 15 s), for screenshots. */
function selfTestDemo(): str {
    return "";
}

/** Records one check. */
function check(name: str, ok: num, got: str, want: str) {
    if (ok == 1) {
        global testPass += 1;
        default.sendMessage(s"<green>MECHTEST PASS %var(name)");
    } else {
        global testFail += 1;
        default.sendMessage(s"<red>MECHTEST FAIL %var(name) got %var(got) want %var(want)");
    }
}

/** Checks a number is within tol of want. */
function checkNum(name: str, got: num, want: num, tol: num) {
    line ok = 0;
    if (num.abs(got - want) <= tol) {
        line ok = 1;
    }
    check(name, line ok, "%var(got)", "%var(want)");
}

/** Checks two strings are equal. */
function checkStr(name: str, got: str, want: str) {
    line ok = 0;
    if (got == want) {
        line ok = 1;
    }
    check(name, line ok, got, want);
}

/** Puts mech c at ground point base facing yaw and redraws it (parts and
 * hitboxes). */
function testPlace(c: num, base: vec, yaw: num) {
    global mPos[c] = base + vec(0, global mechHover, 0);
    global mYaw[c] = yaw;
    global mF[c] = yawToVec(yaw);
    drawMech(c);
}

/** Number field of mech c's loss state (combat/loss.tc). */
function lossNum(c: num, key: str): num {
    return (global mLoss[c])[key] as num;
}

/** Destroys part i of mech c outright. */
function testKill(c: num, i: num) {
    applyHit(c, i, 100000, vec(0, 0, 0));
}

/** Role of the first part hit by segment base + a -> base + b, or "none". */
function testRay(base: vec, a: vec, b: vec): str {
    line hit = segmentHit(base + a, base + b, 0);
    line c = line hit["mech"] as num;
    if (line c == 0) {
        return "none";
    }
    return global mPartRole[global mPartStart[line c] + (line hit["part"] as num)];
}

/** Runs every check. */
function runSelfTest {
    global testPass = 0;
    global testFail = 0;
    default.sendMessage(s"<gold>MECHTEST BEGIN");
    // The mech loop runs without any command having started it (MEC-101).
    line beat = game.ticksSinceStartup - global lastBeat;
    checkNum("mech loop running", line beat, 0, 2);
    clearMechs();
    ensureFloor();
    ensureCatalog();

    // Join flow (MEC-71): the pack sent on join loads (the test client
    // accepts server packs), within 10 s.
    line waited = 0;
    while (packLoaded(default.uuid) == 0 && line waited < 200) {
        wait(5);
        line waited += 5;
    }
    checkNum("pack loaded after join", packLoaded(default.uuid), 1, 0);
    line using = 0;
    if (default.isUsingResourcePack()) {
        line using = 1;
    }
    checkNum("client using the pack", line using, 1, 0);

    // Catalog and loadouts.
    checkNum("catalog walker hp", partNum("walker", "hp"), 400, 0);
    line walkerLo = defaultLoadout("walker");
    checkStr("walker default main", walkerLo["main"] as str, "railgun");
    checkStr("walker default armor", walkerLo["armor"] as str, "armor_light");
    checkStr("spider default main", defaultLoadout("spider")["main"] as str, "lmg");
    line st = deriveStats(line walkerLo);
    checkNum("walker hull hp", st["hullHp"] as num, 440, 0.01);
    checkNum("walker reduction", st["reduction"] as num, 0.1, 0.001);

    // One walker at the arena center, facing +z (left = +x).
    line base = vec(global arenaX, global floorY, global arenaZ);
    spawnMech(line walkerLo);
    line w = global mCount;
    testPlace(line w, line base, 0);
    checkNum("walker parts", global mPartCount[line w], 10, 0);

    // Hitbox rays: hull from the front, the gap between the feet, a shin from
    // the left (shin 1 is the left leg, midpoint about (0.86, 0.48, -0.39)).
    checkStr("ray front hits hull", testRay(line base, vec(0, 2.6, 10), vec(0, 2.6, -10)), "hull");
    checkStr("ray between feet misses", testRay(line base, vec(0, 0.3, 10), vec(0, 0.3, -10)), "none");
    checkStr("ray from left hits shin1", testRay(line base, vec(10, 0.48, -0.39), vec(-10, 0.48, -0.39)), "shin1");

    // Damage: 10% armor; shin HP = 400 * 0.3 * 1.1 = 132.
    checkNum("hit hull 100 deals 90", applyHit(line w, 0, 100, vec(0, 0, 0)), 90, 0.01);
    checkNum("hull hp after hit", global hbHp[global mPartStart[line w]], 350, 0.01);
    checkNum("shin1 destroyed deals its hp", applyHit(line w, 7, 10000, vec(0, 0, 0)), 132, 0.01);
    checkNum("destroyed part takes nothing", applyHit(line w, 7, 100, vec(0, 0, 0)), 0, 0);
    checkStr("ray passes destroyed shin1 to shin2", testRay(line base, vec(10, 0.48, -0.39), vec(-10, 0.48, -0.39)), "shin2");

    // Part loss (MEC-37): a walker with a lost leg is immobile but armed.
    checkNum("walker legs left", lossNum(line w, "legsLeft"), 1, 0);
    checkNum("walker one leg lost immobile", lossNum(line w, "mobility"), 0, 0);
    checkNum("lost shin is debris", global dbEnt.len(), 1, 0);
    testKill(line w, 8);
    checkNum("lost thigh takes its shin", global hbHp[global mPartStart[line w] + 9], 0, 0);
    checkNum("walker no legs", lossNum(line w, "legsLeft"), 0, 0);
    testKill(line w, 2);
    checkNum("main gun lost", lossNum(line w, "mainOk"), 0, 0);
    checkNum("still armed with secondary", lossNum(line w, "armed"), 1, 0);
    testKill(line w, 3);
    checkNum("both guns lost disarmed", lossNum(line w, "armed"), 0, 0);
    testKill(line w, 1);
    checkNum("torso lost locks", lossNum(line w, "torsoLocked"), 1, 0);
    testKill(line w, 4);
    checkNum("augment 1 lost", lossNum(line w, "aug1Ok"), 0, 0);
    checkNum("augment 2 kept", lossNum(line w, "aug2Ok"), 1, 0);
    // Splash radius 1 at the hull center reaches only the hull: 100 * 0.9.
    checkNum("splash at hull center", splashHit(line base + vec(0, 2.6, 0), 1, 100, 0), 90, 0.01);
    checkNum("hull hp after splash", global hbHp[global mPartStart[line w]], 260, 0.01);

    // Turned to yaw 90 (facing -x), the hull is hit from -x.
    testPlace(line w, line base, 90);
    checkStr("turned ray hits hull", testRay(line base, vec(-10, 2.6, 0), vec(10, 2.6, 0)), "hull");

    // Part counts per class.
    for (line cls of ["sprinter", "crawler", "spider"]) {
        spawnMech(defaultLoadout(line cls as str));
        line want = 10;
        if (line cls as str == "crawler") {
            line want = 18;
        } else if (line cls as str == "spider") {
            line want = 14;
        }
        checkNum("%var(cls) parts", global mPartCount[global mCount], line want, 0);
    }

    // Leg loss per class: crawler slows per leg, spider stops climbing.
    line crawler = global mCount - 1;
    line spider = global mCount;
    testKill(line crawler, 7);
    checkNum("crawler 5 legs slower", lossNum(line crawler, "mobility"), 0.667, 0.01);
    testKill(line crawler, 9);
    testKill(line crawler, 11);
    checkNum("crawler 3 legs immobile", lossNum(line crawler, "mobility"), 0, 0);
    checkNum("spider climbs when whole", lossNum(line spider, "climb"), 1, 0);
    testKill(line spider, 7);
    checkNum("spider 3 legs can't climb", lossNum(line spider, "climb"), 0, 0);
    checkNum("spider 3 legs slower", lossNum(line spider, "mobility"), 0.6, 0.001);
    testKill(line spider, 9);
    checkNum("spider 2 legs immobile", lossNum(line spider, "mobility"), 0, 0);

    // Destruction (MEC-38): a fresh walker 40 blocks east, hull destroyed by
    // mech 1.
    line wreckBase = line base + vec(40, 0, 0);
    spawnMech(line walkerLo);
    line d = global mCount;
    testPlace(line d, line wreckBase, 0);
    line before = global dbEnt.len();
    checkStr("target alive before", testRay(line wreckBase, vec(0, 2.6, 10), vec(0, 2.6, -10)), "hull");
    applyHit(line d, 0, 100000, vec(0, 0, 0), line w);
    checkNum("hull lost destroys mech", global mAlive[line d], 0, 0);
    checkNum("every part becomes debris", global dbEnt.len() - line before, 10, 0);
    checkNum("killer recorded", global mLastHit[line d], line w, 0);
    checkNum("destroyed mech takes no hits", applyHit(line d, 1, 100, vec(0, 0, 0)), 0, 0);
    checkStr("rays pass a destroyed mech", testRay(line wreckBase, vec(0, 2.6, 10), vec(0, 2.6, -10)), "none");

    // Debris lands and is removed after about a second.
    wait(30);
    checkNum("debris cleaned up", global dbEnt.len(), 0, 0);

    // HUD layout (MEC-53): widths match the client's font layout and items
    // rewind to the bar center.
    checkNum("hud width A m", hudWidth("A", "m"), 5.5, 0);
    checkNum("hud width A0 .W m", hudWidth("A0 .W", "m"), 23.25, 0);
    checkNum("hud width A s", hudWidth("A", "s"), 3.75, 0);
    checkStr("hud space -7.75", hudSpace(-7.75), "<font:mech:ui>\uF804\uF802\uF801\uF8A3</font>");
    checkStr("hud space 0", hudSpace(0), "");
    checkStr("hud font row -3", hudFont("m", -3), "mech:hud/m_n3");
    // Damage schema (MEC-55): one glyph per part, colored by HP.
    line noDome = defaultLoadout("crawler");
    line noDome["aug2"] = "emp";
    spawnMech(line noDome);
    line sc = global mCount;
    line items = schemaItems(line sc);
    checkNum("schema crawler glyphs", line items.len(), 18, 0);
    checkNum("schema intact cyan", (line items[1] as dict)["palette"] as num, 3, 0);
    applyHit(line sc, 0, 300, vec(0, 0, 0));
    checkNum("schema damaged hull amber", (schemaItems(line sc)[1] as dict)["palette"] as num, 4, 0);
    testKill(line sc, 7);
    checkNum("schema lost shin grey", (schemaItems(line sc)[8] as dict)["palette"] as num, 2, 0);
    spawnMech(defaultLoadout("walker"));
    checkNum("schema dome adds shield", schemaItems(global mCount).len(), 12, 0);

    // Screen effects (MEC-59): marker color, pulses expire.
    checkStr("fx color visor+lowhp", fxColor(192, 0, 15), "#C000FF");
    line me = default.uuid;
    fxCockpit(line me, 1);
    checkNum("fx cockpit visor", fxMaskOf(line me), 64, 0);
    fxPulse(line me, 2, 5);
    checkNum("fx pulse on", fxMaskOf(line me), 66, 0);
    wait(10);
    checkNum("fx pulse expired", fxMaskOf(line me), 64, 0);
    checkStr("fx marker sent", global fxSent[line me] as str, "#4000FF");
    fxCockpit(line me, 0);

    // Cockpit (MEC-54): frame corners and crosshair on the HUD, a reticle
    // 40 blocks out along the guns.
    spawnMech(defaultLoadout("walker"));
    line cw = global mCount;
    cockpitShow(line me, line cw);
    line panels = global hudPanels[line me] as dict;
    line framed = 0;
    if (line panels.hasKeys("frame4") && line panels.hasKeys("crosshair")) {
        line framed = 1;
    }
    check("cockpit frame panels", line framed, "missing", "frame1-4, crosshair");
    line hasRet = 0;
    if (global retOf.hasKeys(line me)) {
        line hasRet = 1;
    }
    check("cockpit reticle spawned", line hasRet, "none", "one");
    line mount = toWorld(vec(global mPos[line cw].x, global floorY, global mPos[line cw].z), global mF[line cw], vec(-0.95, 3.6, 0.4));
    checkNum("reticle 12 ahead of the gun", (reticlePoint(line cw) - line mount).len(), 12, 0.05);
    checkStr("railgun crosshair", crosshairGlyph("railgun")[1] as str, "\uE240");
    cockpitHide(line me);
    line gone = 1;
    if (global retOf.hasKeys(line me)) {
        line gone = 0;
    }
    check("cockpit hidden", line gone, "still there", "removed");

    // Menu (MEC-72) and main screen (MEC-73): open, hit tests at canvas
    // points (a seated player cannot be turned with setRotation), clicks.
    menuOpen("main");
    checkNum("menu open", menuIsOpen(line me), 1, 0);
    checkNum("main screen widgets", ((global menuOf[line me] as dict)["widgets"] as list).len(), 21, 0);
    line prevW = ((global menuOf[line me] as dict)["widgets"] as list)[16] as dict;
    checkStr("party preview widget", prevW["kind"] as str, "preview");
    checkNum("preview has every part", ((prevW["preview"] as dict)["ents"] as list).len(), partTotal(playerLoadout()["cls"] as str), 0);
    checkStr("hit play", menuHitAt(vec(0 - 150, 45, 0)), "play");
    checkStr("hit settings", menuHitAt(vec(0 - 125, 0 - 160, 0)), "settings");
    checkStr("hit nothing", menuHitAt(vec(0, 100, 0)), "");
    menuClickAt(vec(0 - 88, 0 - 20, 0));
    checkStr("map next runs", global menuLastAction, "map next");
    checkStr("map still picked", pickedMap(line me), "PROVING GROUNDS");
    // Customizer (MEC-75): picks save the loadout; back returns to main.
    line keepLo = pdGet(line me, "lo");
    menuAction("customize");
    checkStr("customizer open", (global menuOf[line me] as dict)["screen"] as str, "custom");
    menuAction("pick spider");
    checkStr("pick class saves", playerLoadout()["cls"] as str, "spider");
    menuAction("cat main");
    checkStr("category switch", custCat(line me), "main");
    menuAction("pick autocannon");
    checkStr("pick main gun saves", playerLoadout()["main"] as str, "autocannon");
    menuAction("pick railgun");
    checkStr("spider railgun allowed", playerLoadout()["main"] as str, "railgun");
    menuAction("back");
    checkStr("back to main", (global menuOf[line me] as dict)["screen"] as str, "main");
    pdSet(line me, "lo", line keepLo);
    global custCatOf.remove(line me);
    menuAction("back");
    checkNum("back closes the menu", menuIsOpen(line me), 0, 0);

    testPlayerData();
    testSettings();
    testParty();

    hudReset(default.uuid);
    hudDemo(default.uuid);
    hudRemove(default.uuid, "schema");
    schemaShowTo(default.uuid, line sc);
    line bars = global hudSent[default.uuid] as list;
    checkNum("hud three bars", line bars.len(), 3, 0);

    testQueue();
    clearMechs();
    line passed = global testPass;
    line failed = global testFail;
    default.sendMessage(s"<gold>MECHTEST DONE %var(passed) passed %var(failed) failed");
    // Visual demo for screenshots (selfTestDemo()): the demo HUD, then
    // each screen effect for 12 s.
    line me2 = default.uuid;
    if (selfTestDemo() == "fx") {
        for (line stage of ["zoom", "fade", "hrb", "visor", "lowhp", "emp", "shake"]) {
            line name = line stage as str;
            default.sendMessage(s"<gold>MECHTEST FX %var(name)");
            fxCockpit(line me2, 0);
            if (line name == "zoom") {
                fxSetStrength(line me2, 0.5);
                fxSetBit(line me2, 1, 1);
            } else if (line name == "fade") {
                fxDeathFade(line me2);
            } else if (line name == "hrb") {
                fxSetBit(line me2, 32, 1);
            } else if (line name == "visor") {
                fxCockpit(line me2, 1);
            } else if (line name == "lowhp") {
                fxSetBit(line me2, 128, 1);
            } else if (line name == "emp") {
                fxSetBit(line me2, 16, 1);
            } else {
                fxPulse(line me2, 2, 240);
            }
            wait(240);
        }
    } else if (selfTestDemo() == "cockpit") {
        // A walker facing where the player looks, its cockpit on the
        // player's HUD and its reticle out ahead.
        hudReset(line me2);
        spawnMech(defaultLoadout("walker"));
        line dc = global mCount;
        // Just behind the player, facing the same way, so its reticle floats
        // ahead in clear view (a seated pilot looks over the hull instead).
        // Unpiloted: a pilot would turn it to their body yaw. The reticle
        // stays where cockpitShow put it.
        line lookYaw = default.eyeLocation.getCoordinate(coord="Yaw");
        line ahead = yawToVec(line lookYaw);
        line feet = default.location;
        testPlace(line dc, vec(line feet.x, global floorY, line feet.z) - line ahead * 4, line lookYaw);
        cockpitShow(line me2, line dc);
        line rp = reticlePoint(line dc);
        line eyeAt = default.eyeLocation;
        line dist = num.floor((line rp - vec(line eyeAt.x, line eyeAt.y, line eyeAt.z)).len());
        default.sendMessage(s"<gold>MECHTEST FX cockpit reticle %var(rp) dist %var(dist)");
        wait(300);
        cockpitHide(line me2);
    } else if (selfTestDemo() == "custom") {
        hudReset(line me2);
        menuOpen("custom");
        default.sendMessage(s"<gold>MECHTEST FX custom");
        wait(300);
        menuClose();
    } else if (selfTestDemo() == "party") {
        hudReset(line me2);
        for (line t of ["ta", "tb"]) {
            global playerNames["test-%var(t)"] = "Tester_%var(t)";
            partyInviteUuid(line me2, "test-%var(t)");
            partyAccept("test-%var(t)");
        }
        global playerNames["test-tc"] = "Tester_tc";
        partyInviteUuid("test-tc", line me2);
        menuOpen("main");
        default.sendMessage(s"<gold>MECHTEST FX party");
        wait(300);
        menuClose();
        global partyOf = {};
        global partyList = {};
        global partyInvite = {};
    } else if (selfTestDemo() == "queue") {
        hudReset(line me2);
        menuOpen("queue");
        default.sendMessage(s"<gold>MECHTEST FX queue");
        wait(300);
        menuClose();
    } else if (selfTestDemo() == "settings") {
        hudReset(line me2);
        menuOpen("settings");
        default.sendMessage(s"<gold>MECHTEST FX settings");
        wait(300);
        menuClose();
    } else if (selfTestDemo() == "menu") {
        hudReset(line me2);
        menuOpen("main");
        default.sendMessage(s"<gold>MECHTEST FX menu");
        wait(300);
        menuClose();
    } else if (selfTestDemo() == "hud") {
        wait(200);
    }
    fxCockpit(line me2, 0);
    hudReset(default.uuid);
    default.sendMessage(s"<gold>MECHTEST FX end");
}

/** Saved player data checks (MEC-78). The player's real record is kept and
 * put back at the end. */
function testPlayerData {
    line me = default.uuid;
    line keep = pdOf(line me);
    checkNum("player data version", pdNum(line me, "v"), pdVersion(), 0);
    // A new player: defaults everywhere.
    saved "pd %var(me)" = {};
    checkNum("new player credits", playerCredits(line me), 0, 0);
    checkStr("new player loadout", playerLoadout()["cls"] as str, "walker");
    checkNum("new player tier", partTier(line me, "railgun"), 0, 0);
    checkStr("setting default", playerSetting(line me, "fov", "x") as str, "x");
    // Numbers, lists and sub-dicts.
    pdAddNum(line me, "cr", 25);
    checkNum("credits add", playerCredits(line me), 25, 0);
    checkNum("credits floor at 0", pdAddNum(line me, "cr", -100), 0, 0);
    pdAdd(line me, "unl", "railgun");
    pdAdd(line me, "unl", "railgun");
    checkNum("unlock added once", (pdGet(line me, "unl") as list).len(), 1, 0);
    checkNum("unlock owned", pdHas(line me, "unl", "railgun"), 1, 0);
    pdSetSub(line me, "upg", "railgun", 2);
    checkNum("upgrade tier", partTier(line me, "railgun"), 2, 0);
    saveLoadout({cls: "spider"});
    checkStr("loadout saved", playerLoadout()["cls"] as str, "spider");
    checkNum("write stamps version", pdNum(line me, "v"), pdVersion(), 0);
    // The main screen reads credits from the record.
    pdAddNum(line me, "cr", 40);
    menuOpen("main");
    line label = "";
    for (line w of (global menuOf[line me] as dict)["widgets"] as list) {
        if ((line w as dict)["id"] as str == "credits") {
            line label = (line w as dict)["text"] as str;
        }
    }
    checkStr("main screen credits", line label, "CREDITS 40");
    menuClose();
    // Migration from the pre-MEC-78 loadout variable.
    saved "pd %var(me)" = {};
    saved "loadout %var(me)" = {cls: "crawler"};
    pdLoad(line me);
    checkStr("legacy loadout migrated", playerLoadout()["cls"] as str, "crawler");
    checkNum("legacy variable purged", (saved "loadout %var(me)" as dict).len(), 0, 0);
    checkNum("migrated version", pdNum(line me, "v"), pdVersion(), 0);
    // Size of a record that owns and upgraded every part.
    line upg = {};
    for (line id of global partOrder) {
        line upg[line id as str] = 5;
    }
    line full = {
        v: pdVersion(), lo: defaultLoadout("walker"), cr: 999999, pts: 99999, xp: 9999999,
        unl: global partOrder, cos: global partOrder, upg: line upg,
        prof: {banner: "banner_01", title: "title_01", showLevel: 1, showKills: 1},
        set: {s01: 1, s02: 1, s03: 1, s04: 1, s05: 1, s06: 1, s07: 1, s08: 1, s09: 1, s10: 1, s11: 1, s12: 1}
    };
    saved "pd %var(me)" = line full;
    line size = pdSize(line me);
    line parts = global partOrder.len();
    default.sendMessage(s"<gray>MECHTEST INFO full player record %var(size) chars, %var(parts) parts");
    line small = 0;
    if (line size < 2000) {
        line small = 1;
    }
    check("full record under 2000 chars", line small, "%var(size)", "< 2000");
    saved "pd %var(me)" = line keep;
}

/** Settings checks (MEC-76): the screen, saved choices, the effect bits they
 * allow and the cursor speed. The player's record is put back at the end. */
function testSettings {
    line me = default.uuid;
    line keep = pdOf(line me);
    saved "pd %var(me)" = {};
    settingsApply(line me);
    checkNum("effects allowed by default", global fxAllowedOf[line me] as num, 255, 0);
    menuOpen("main");
    menuAction("settings");
    checkStr("settings open", (global menuOf[line me] as dict)["screen"] as str, "settings");
    checkStr("hit effects reduced", menuHitAt(vec(38, 0 - 40, 0)), "fx_reduced");
    menuClickAt(vec(38, 0 - 40, 0));
    checkStr("effects saved", setFx(line me), "reduced");
    checkNum("reduced drops visor and tint", global fxAllowedOf[line me] as num, 187, 0);
    // The marker carries the cockpit visor (64) only while effects allow it.
    fxCockpit(line me, 1);
    checkStr("reduced marker has no visor", global fxSent[line me] as str, fxColor(0, 0, 15));
    menuAction("set fx full");
    checkStr("full marker has the visor", global fxSent[line me] as str, fxColor(64, 0, 15));
    menuAction("set fx off");
    checkNum("off keeps zoom and fade", global fxAllowedOf[line me] as num, 9, 0);
    menuAction("set fx full");
    menuAction("set shake 0");
    checkNum("shake off", global fxAllowedOf[line me] as num, 253, 0);
    menuAction("set sens 8");
    checkNum("cursor speed saved", cursorPerDegree(line me), 8, 0);
    line w = (global menuOf[line me] as dict)["widgets"] as list;
    line green = 0;
    for (line wv of line w) {
        if ((line wv as dict)["id"] as str == "sens_8" && (line wv as dict)["palette"] as num == 6) {
            line green = 1;
        }
    }
    checkNum("current choice green", line green, 1, 0);
    menuAction("home");
    checkStr("settings back home", (global menuOf[line me] as dict)["screen"] as str, "main");
    menuClose();
    fxCockpit(line me, 0);
    saved "pd %var(me)" = line keep;
    settingsApply(line me);
}

/** Ids of the widgets on the player's open screen. */
function screenIds(uuid: str): list {
    line ids = [];
    for (line w of (global menuOf[uuid] as dict)["widgets"] as list) {
        line ids.append((line w as dict)["id"]);
    }
    return line ids;
}

/** Party checks (MEC-77) with stand-in members (test uuids that are not on
 * the plot). Parties are reset before and after. */
function testParty {
    line me = default.uuid;
    global partyOf = {};
    global partyList = {};
    global partyInvite = {};
    for (line t of ["ta", "tb", "tc", "td", "te"]) {
        global playerNames["test-%var(t)"] = "Tester_%var(t)";
    }
    checkNum("solo has no party", partyIdOf(line me), 0, 0);
    checkStr("solo leads itself", partyLeader(line me), line me);
    checkStr("invite by name", uuidByName("tester_TA"), "test-ta");
    checkStr("invite sent", partyInviteUuid(line me, "test-ta"), "");
    checkNum("inviting starts a party", num.min(partyIdOf(line me), 1), 1, 0);
    checkStr("accept", partyAccept("test-ta"), "");
    checkNum("two members", partyMembers(line me).len(), 2, 0);
    checkNum("allied", allied(line me, "test-ta"), 1, 0);
    checkNum("not allied", allied(line me, "test-tb"), 0, 0);
    checkStr("no double invite", partyInviteUuid(line me, "test-ta"), "already in your party");
    for (line t of ["tb", "tc", "td"]) {
        partyInviteUuid(line me, "test-%var(t)");
        partyAccept("test-%var(t)");
    }
    checkNum("five members", partyMembers(line me).len(), 5, 0);
    checkStr("party full", partyInviteUuid(line me, "test-te"), "your party is full");
    checkStr("accept without invite", partyAccept("test-te"), "no open invite");
    menuOpen("main");
    line previews = 0;
    for (line w of (global menuOf[line me] as dict)["widgets"] as list) {
        if ((line w as dict)["kind"] as str == "preview") {
            line previews += 1;
        }
    }
    checkNum("five mechs on the main screen", line previews, 5, 0);
    line ids = screenIds(line me);
    checkNum("full party has no invite button", line ids.find("invite"), 0, 0);
    checkNum("leave button", num.min(line ids.find("leave"), 1), 1, 0);
    checkStr("member names", nameOf(partyMembers(line me)[2] as str), "Tester_ta");
    checkStr("kick", partyKick(line me, "test-td"), "");
    checkNum("kicked", partyMembers(line me).len(), 4, 0);
    checkStr("only the leader kicks", partyKick("test-ta", "test-tb"), "only the party leader can remove members");
    // The leader leaves: the next member leads.
    menuAction("party leave");
    checkNum("left", partyIdOf(line me), 0, 0);
    checkStr("lead passes on", partyLeader("test-ta"), "test-ta");
    // An invite to the player shows on the main screen and is accepted there.
    partyInviteUuid("test-ta", line me);
    menuOpen("main");
    checkNum("invite banner", num.min(screenIds(line me).find("inviteAccept"), 1), 1, 0);
    menuAction("party accept");
    checkNum("joined from the banner", allied(line me, "test-ta"), 1, 0);
    checkNum("member cannot invite", screenIds(line me).find("invite"), 0, 0);
    // Expired invites; a party of one is disbanded.
    partyInviteUuid("test-ta", "test-te");
    global partyInvite["test-te"] = {party: partyIdOf("test-ta"), from: "test-ta", until: 0};
    checkStr("invite expires", partyAccept("test-te"), "no open invite");
    for (line t of ["tb", "tc"]) {
        partyLeave("test-%var(t)");
    }
    partyLeave(line me);
    checkNum("party of one disbanded", partyIdOf("test-ta"), 0, 0);
    checkNum("no parties left", global partyList.len(), 0, 0);
    menuClose();
    global partyOf = {};
    global partyList = {};
    global partyInvite = {};
    for (line t of ["ta", "tb", "tc", "td", "te"]) {
        global playerNames.remove("test-%var(t)");
    }
}

/** Queue checks (MEC-74): the cap, the selector, leader-only joins and a
 * drop into the player's own mech. Leaves the mech and clears it after. */
function testQueue {
    line me = default.uuid;
    checkNum("party fits under the cap", queueFits(18, 2), 1, 0);
    checkNum("party over the cap", queueFits(19, 2), 0, 0);
    global playerNames["test-ta"] = "Tester_ta";
    partyInviteUuid("test-ta", line me);
    partyAccept(line me);
    checkStr("member cannot queue", queueJoin(line me, "ffa"), "only your party leader can queue");
    partyLeave(line me);
    global playerNames.remove("test-ta");
    menuOpen("main");
    menuAction("queue");
    checkStr("queue selector open", (global menuOf[line me] as dict)["screen"] as str, "queue");
    checkStr("hit ranked card", menuHitAt(vec(0, 15, 0)), "join_extraction");
    checkStr("hit casual card", menuHitAt(vec(150, 15, 0)), "join_ffa");
    menuClickAt(vec(150, 15, 0));
    checkNum("drop closes the menu", menuIsOpen(line me), 0, 0);
    checkNum("dropped into a mech", num.min(mechOf(line me), 1), 1, 0);
    checkStr("mode recorded", global modeOf[line me] as str, "ffa");
    // Clearing the mechs takes the pilot's cockpit view down (MEC-104).
    clearMechs();
    checkNum("clear drops the visor", fxMaskOf(line me), 0, 0);
    line panels = {};
    if (global hudPanels.hasKeys(line me)) {
        line panels = global hudPanels[line me] as dict;
    }
    line shown = 0;
    if (line panels.hasKeys("schema") || line panels.hasKeys("crosshair")) {
        line shown = 1;
    }
    checkNum("clear hides schema and cockpit", line shown, 0, 0);
    global modeOf.remove(line me);
}

/** Join hook: runs the self-test a second after the player enters play
 * mode, when selfTestOnJoin() is 1. */
function selfTestJoin {
    if (selfTestOnJoin() == 1) {
        wait(20);
        runSelfTest();
    }
}
